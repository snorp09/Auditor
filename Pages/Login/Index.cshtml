@page
@model Auditor.Pages.Login.IndexModel

@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center h-100">
    <div class="card p-4" style="width: 400px;">
        <h2 class="card-title text-center mb-4">Login</h2>
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" type="password" />
                <button type="button" class="btn btn-link p-0" data-bs-toggle="modal"
                        data-bs-target="#forgotPasswordModal">Forgot
                    Password?</button>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <p class="mt-3 text-center">Don't have an account? <a asp-page="/Login/Signup">Sign up</a></p>
        </div>
    </div>
</div>

<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="forgotPasswordModalLabel">Forgot Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" id="resetForm">
                    <div class="mb-3">
                        <label for="forgotPasswordEmail" class="form-label">Enter your email address</label>
                        <input type="email" class="form-control" id="forgotPasswordEmail" name="email" required />
                    </div>
                    <button type="button" class="btn btn-primary" onclick="onSendReset()">Send Reset Link</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const resetForm = document.querySelector("form#resetForm");
    resetForm.addEventListener("submit", e => {
        e.preventDefault();
    })
    async function onSendReset() {
        const email = document.getElementById("forgotPasswordEmail");
        const resetUrl = new URL("/api/Auth/passwordreset", window.location.origin);
        resetUrl.search = new URLSearchParams({ email: email.value }).toString();
        const req = await fetch(resetUrl, {
            method: "POST",
        });
        if (req.redirected) {
            window.location.href = req.url;
        }
    }
</script>