@using Auditor.Models;

@model Transaction;

<tr class="align-middle">
    <td>@Model.Name</td>
    <td class="@(Model.Type == Auditor.Models.TransactionType.Income ? "text-success" : "text-danger")">
        @(Model.Type == Auditor.Models.TransactionType.Income ? "+" : "-")@Model.Amount
    </td>
    <td>@Model.Date.ToString("yyyy-MM-dd")</td>
    <td>
        <form method="post" asp-page="Flag" asp-page-handler="FlagTransaction" class="d-inline">
            <input type="hidden" name="transactionId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <button type="submit" class="btn btn-sm @(Model.IsFlagged ? "btn-warning" : "btn-outline-warning")">
                <i class="ph ph-flag"></i>
            </button>
        </form>
    </td>
</tr>