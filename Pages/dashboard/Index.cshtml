@page
@model Auditor.Pages.Dashboard.IndexModel
@{
    Layout = "_DashLayout";
    ViewData["Title"] = "Home";
}

<div class="d-flex flex-column my-2">
    <h1 class="h4">Dashboard</h1>
    <h1 class="h6 text-muted">Welcome, @Model.CurrentUser?.Name</h1>
</div>

<div class="d-flex flex-column p-4 border rounded">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4">Last 10 Transactions</h1>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTransactionModal">Add Transaction</button>
    </div>

    <div class="overflow-auto" style="max-height: 400px;">
        <table class="table table-striped">
            <thead class="sticky-top bg-white">
                <tr>
                    <th>Name</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    <partial name="EntryRow" model="transaction" />
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addTransactionModal" tabindex="-1" aria-labelledby="addTransactionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTransactionModalLabel">Add Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addTransactionForm" method="post">
                    <div class="mb-3">
                        <label for="transactionName" class="form-label" asp-for="IncomingTransaction.Name">Name</label>
                        <input type="text" class="form-control" id="transactionName" asp-for="IncomingTransaction.Name" required>
                    </div>
                    <div class="mb-3">
                        <label for="transactionAmount" class="form-label" asp-for="IncomingTransaction.Amount">Amount</label>
                        <input type="number" step="0.01" class="form-control" id="transactionAmount" asp-for="IncomingTransaction.Amount" required>
                        <div class="btn-group my-2" role="group" aria-label="Transaction Type">
                            <input type="radio" class="btn-check" id="incomeRadio" value="@Auditor.Models.TransactionType.Income" checked asp-for="IncomingTransaction.Type">
                            <label class="btn btn-outline-success" for="incomeRadio">Income</label>

                            <input type="radio" class="btn-check" id="expenseRadio" value="@Auditor.Models.TransactionType.Expense" asp-for="IncomingTransaction.Type">
                            <label class="btn btn-outline-danger" for="expenseRadio">Expense</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="transactionDate" class="form-label" asp-for="IncomingTransaction.Date">Date & Time</label>
                        <input type="datetime-local" class="form-control" id="transactionDate" asp-for="IncomingTransaction.Date" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" form="addTransactionForm" class="btn btn-primary">Add Transaction</button>
            </div>
        </div>
    </div>
</div>